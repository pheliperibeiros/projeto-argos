# ============================================================
#  ARGOS - Variáveis de Ambiente
#  Copie este arquivo para .env.local e preencha os valores.
# ============================================================

# -------------------------------------------------------
#  MODO DE BACKEND
#  'supabase' → usa o SDK Supabase (ambiente atual/Netlify)
#  'api'      → usa API REST própria (ambiente institucional)
#  'sheets'   → usa planilhas do Google Sheets (através de Google Apps Script ou LocalStorage)
# -------------------------------------------------------
VITE_BACKEND_MODE=sheets

# -------------------------------------------------------
#  MODO: google sheets
#  Preencha com a URL de publicação do seu Google Apps Script Web App.
#  Deixe vazio para usar o Fallback de Armazenamento Local (LocalStorage) para testes imediatos.
# -------------------------------------------------------
VITE_GOOGLE_SHEETS_WEBAPP_URL=
# Chave secreta de autorização compartilhada com o Google Apps Script (gerar uma chave forte aleatória)
VITE_GOOGLE_SHEETS_API_KEY=argos_sec_key_change_me_in_production

# -------------------------------------------------------
#  MODO: supabase
#  Preencha apenas se VITE_BACKEND_MODE=supabase
# -------------------------------------------------------
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY_AQUI

# -------------------------------------------------------
#  MODO: api (Ambiente Institucional - Intranet)
#  Preencha apenas se VITE_BACKEND_MODE=api
#  Exemplo: http://argos.intranet.gov.br/api
# -------------------------------------------------------
VITE_API_BASE_URL=

# -------------------------------------------------------
#  AUTENTICAÇÃO (Ambiente Institucional)
#  'google'  → Google OAuth2 (Google Workspace institucional)
#  'local'   → Login próprio com usuário e senha
#  'sso'     → SSO da instituição (LDAP/AD/OpenID Connect)
# -------------------------------------------------------
VITE_AUTH_PROVIDER=google

# Google OAuth2 (necessário se VITE_AUTH_PROVIDER=google)
# Obtido no Google Cloud Console da instituição
VITE_GOOGLE_CLIENT_ID=

# Usado apenas no dashboard do Supabase (Edge Functions) — nunca expor no frontend
# SUPABASE_SERVICE_ROLE_KEY=nunca-expor-no-frontend

